{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/color-guessing-game-online",
      "destination": "/color-guessing-game",
      "permanent": true
    },
    {
      "source": "/color-game",
      "destination": "/color-guessing-game",
      "permanent": true
    },
    {
      "source": "/guess-the-color",
      "destination": "/color-guessing-game",
      "permanent": true
    },
    {
      "source": "/color-challenge",
      "destination": "/color-guessing-game",
      "permanent": true
    },
    {
      "source": "/color-quiz",
      "destination": "/color-guessing-game",
      "permanent": true
    },
    {
      "source": "/color-test",
      "destination": "/color-guessing-game",
      "permanent": true
    },
    {
      "source": "/rgb-color-guessing-game",
      "destination": "/rgb-color-game",
      "permanent": true
    },
    {
      "source": "/hex-color-guessing-game",
      "destination": "/hex-color-game",
      "permanent": true
    },
    {
      "source": "/color-match-game",
      "destination": "/color-matching-game",
      "permanent": true
    },
    {
      "source": "/color-theory-quiz",
      "destination": "/color-theory-game",
      "permanent": true
    },
    {
      "source": "/color-guessing-game-faq",
      "destination": "/faq",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/color-guessing-game",
      "destination": "/color-guessing-game.html"
    },
    {
      "source": "/daily-color-challenge",
      "destination": "/daily-color-challenge.html"
    },
    {
      "source": "/rgb-color-game",
      "destination": "/rgb-color-game.html"
    },
    {
      "source": "/hex-color-game",
      "destination": "/hex-color-game.html"
    },
    {
      "source": "/color-picker-game",
      "destination": "/color-picker-game.html"
    },
    {
      "source": "/color-matching-game",
      "destination": "/color-matching-game.html"
    },
    {
      "source": "/color-theory-game",
      "destination": "/color-theory-game.html"
    },
    {
      "source": "/color-game-timed",
      "destination": "/color-game-timed.html"
    },
    {
      "source": "/color-game-practice",
      "destination": "/color-game-practice.html"
    },
    {
      "source": "/color-game-for-beginners",
      "destination": "/color-game-for-beginners.html"
    },
    {
      "source": "/color-converter",
      "destination": "/color-converter.html"
    },
    {
      "source": "/rgb-to-hex",
      "destination": "/rgb-to-hex.html"
    },
    {
      "source": "/hex-to-rgb",
      "destination": "/hex-to-rgb.html"
    },
    {
      "source": "/color-contrast-checker",
      "destination": "/color-contrast-checker.html"
    },
    {
      "source": "/color-distance",
      "destination": "/color-distance.html"
    },
    {
      "source": "/color-codes",
      "destination": "/color-codes.html"
    },
    {
      "source": "/how-to-play",
      "destination": "/how-to-play.html"
    },
    {
      "source": "/color-theory-guide",
      "destination": "/color-theory-guide.html"
    },
    {
      "source": "/color-theory",
      "destination": "/color-theory.html"
    },
    {
      "source": "/understanding-rgb",
      "destination": "/understanding-rgb.html"
    },
    {
      "source": "/understanding-hex-colors",
      "destination": "/understanding-hex-colors.html"
    },
    {
      "source": "/understanding-hsl",
      "destination": "/understanding-hsl.html"
    },
    {
      "source": "/rgb-vs-hex",
      "destination": "/rgb-vs-hex.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/statistics",
      "destination": "/statistics.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/color-guessing-game/easy",
      "destination": "/color-guessing-game/easy.html"
    },
    {
      "source": "/color-guessing-game/medium",
      "destination": "/color-guessing-game/medium.html"
    },
    {
      "source": "/color-guessing-game/hard",
      "destination": "/color-guessing-game/hard.html"
    },
    {
      "source": "/color-guessing-game/expert",
      "destination": "/color-guessing-game/expert.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
